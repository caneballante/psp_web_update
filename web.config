<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <clear />
                <rule name="Redirect HTTP to HTTPS" enabled="false" patternSyntax="Wildcard" stopProcessing="true">
                    <match url="*" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{HTTPS}" pattern="off" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Found" />
                </rule>
                <rule name="Redirect_Old_Orca_to_New_Orca_Page" enabled="false" stopProcessing="true">
                    <match url="^southern-resident-orca-task-force.php" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="recovery-of-southern-resident-orcas.php" redirectType="Permanent" />
                </rule>
                <rule name="Imported Rule 1" stopProcessing="true">
                    <match url="^([^\.]+)$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                        <add input="{URL}" pattern="^/vitalsigns" ignoreCase="false" negate="true" />
                        <add input="{URL}" pattern="^/blog" ignoreCase="false" negate="true" />
                        <add input="{URL}" pattern="^/gis" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.php" />
                </rule>
                <rule name="Imported Rule 2" enabled="false">
                    <match url="^effectiveaction.php$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/evaluating-effective-action.php" redirectType="Found" />
                </rule>
                <rule name="Imported Rule 3" enabled="false">
                    <match url="^SR_src_meetings.php$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/SR_meetings.php" redirectType="Found" />
                </rule>
                <rule name="Imported Rule 4" enabled="false">
                    <match url="^epafunding.php$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/NEP-solicitation-and-grants.php" redirectType="Found" />
                </rule>
                <rule name="Imported Rule 5" enabled="false">
                    <match url="^partnershipnews.php$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/press.php" redirectType="Found" />
                </rule>
                <rule name="Imported Rule 6" enabled="false">
                    <match url="^SP_biennium_work_plan_download.php$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/science-biennial-science-workplan.php" redirectType="Found" />
                </rule>
                <rule name="Imported Rule 7" enabled="false">
                    <match url="^SR_status.php$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/salmon-recovery-status.php" redirectType="Found" />
                </rule>
                <rule name="Imported Rule 8">
                    <match url="^PSEMP/PSmarinewatersoverview.php$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/PSmarinewatersoverview.php" redirectType="Found" />
                </rule>
                <rule name="Hide .html ext">
                    <match url="^(.*)" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:0}.html" />
                </rule>
                <rule name="Redirecting .html ext" stopProcessing="true">
                    <match url="^(.*).html" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{URL}" pattern="(.*).html" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" />
                </rule>


            </rules>
            <outboundRules>
                <rule name="Hide Server Response Headers">
                    <match serverVariable="RESPONSE_SERVER" pattern=".*" />
                    <action type="Rewrite" />
                </rule>
            </outboundRules>
        </rewrite>
     
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="Default.htm" />
                <add value="Default.asp" />
                <add value="index.htm" />
                <add value="index.html" />
                <add value="iisstart.htm" />
            </files>
        </defaultDocument>
        <handlers>
            <clear />
            <add name="php-7.4.9" path="*.php" verb="GET,HEAD,POST" modules="FastCgiModule" scriptProcessor="C:\Program Files\PHP\v7.4.9\php-cgi.exe" resourceType="Either" requireAccess="Script" />
